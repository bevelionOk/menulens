# Copy to .env and fill in — never commit .env
OPENAI_API_KEY=sk-...

# Postgres (matches docker-compose.yml — local dev values)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/menu_extraction

# Fastify listen port (optional — defaults to 3000; Vite proxies /api here)
# PORT=3000

# Staleness threshold in ms (optional — defaults to 180000 = 3 min): a `processing` run
# with no stage change for this long reads as `interrupted` and no longer blocks new runs
# RUN_STALE_AFTER_MS=180000

# Source-class threshold in chars (optional — defaults to 200): a URL or PDF whose
# extracted text has at least this many chars is `text`; a PDF below it is `visual`, a URL
# below it fails with `no_usable_text`
# SOURCE_MIN_TEXT_CHARS=200
